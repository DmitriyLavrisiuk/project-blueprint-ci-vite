{
	"$schema": "https://json.schemastore.org/claude-code-settings.json",
	"permissions": {
		"allow": [
			"Edit(/docs/**)",
			"Edit(/CHANGELOG.md)",
			"Bash(git add *)",
			"Bash(node scripts/check-docs.mjs)"
		],
		"ask": [
			"Bash(git commit *)",
			"Bash(git push *)",
			"Bash(git tag *)",
			"Bash(git merge *)",
			"Bash(git rebase *)",
			"Bash(gh repo *)",
			"Bash(gh pr merge *)"
		],
		"deny": [
			"Read(.env)",
			"Read(.env.*)",
			"Read(!.env.example)",
			"Edit(.env)",
			"Edit(.env.*)",
			"Edit(!.env.example)",
			"Bash(rm -rf *)",
			"Bash(git push --force*)",
			"Bash(git push -f*)",
			"Bash(git reset --hard *)",
			"Bash(git clean -f*)",
			"Bash(gh repo delete *)",
			"Bash(npm publish *)",
			"Bash(curl *)",
			"Bash(wget *)"
		]
	},
	"hooks": {
		"PostToolUse": [
			{
				"matcher": "Write|Edit",
				"hooks": [
					{
						"type": "command",
						"command": "${CLAUDE_PROJECT_DIR}/.claude/hooks/format.sh",
						"args": []
					}
				]
			}
		]
	}
}
