#!/bin/sh
# Секреты не попадают в коммит: gitleaks сканирует застейдженное.
if ! command -v gitleaks >/dev/null 2>&1; then
  echo "pre-commit: нет gitleaks, секреты не проверить — установи: brew install gitleaks" >&2
  exit 1
fi
exec gitleaks git --pre-commit --staged --redact --no-banner --log-level warn --verbose
